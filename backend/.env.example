# Supabase Postgres — use the Session/Transaction pooler connection string,
# not the direct connection (see docs/DOCBRAIN-ARCHITECTURE.md §9.4).
DATABASE_URL=postgresql+psycopg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# In production this MUST be a long random value, not this placeholder —
# anyone who knows it can forge a session for any user. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

STORAGE_ROOT=uploads
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=pdf,doc,docx,xls,xlsx,ppt,pptx,txt,md,csv,png,jpg

# Storage provider — "local" (default) or "supabase". Leave STORAGE_PROVIDER
# as "local" unless you have a Supabase Storage bucket + S3 access keys
# (Project Settings -> Storage -> S3 Connection).
STORAGE_PROVIDER=local
# No square brackets in the placeholder on purpose: a literal "[...]" left
# in this value makes Python read the hostname as an IPv6 literal and fail
# with a thoroughly misleading "Invalid IPv6 URL" (hit for real when
# deploying).
SUPABASE_STORAGE_ENDPOINT=https://your-project-ref.supabase.co/storage/v1/s3
SUPABASE_STORAGE_REGION=
SUPABASE_STORAGE_BUCKET=
SUPABASE_STORAGE_ACCESS_KEY_ID=
SUPABASE_STORAGE_SECRET_ACCESS_KEY=

# Only needed if a browser ever calls the API directly. In the deployed
# setup it doesn't: the browser only ever talks to the Next.js frontend,
# which proxies to this API server-side (frontend/src/app/api/bff), so
# these requests are server-to-server and CORS never applies.
CORS_ORIGINS=http://localhost:3000

# Where the FRONTEND lives. Used only to build the full URL of a share link
# when one is created. Must be the real site URL in production (e.g. your
# Vercel domain) — otherwise generated links point at localhost and are
# useless to the person you send them to.
PUBLIC_APP_URL=http://localhost:3000

# Transactional email (invitations, password resets) via Resend.
# Leave RESEND_API_KEY blank to run without email: the app logs the message
# instead of sending it, and invitations still work because the admin gets a
# copyable link. EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=DocBrain <noreply@your-domain.com>

# AI features (Smart Rename, Smart Tags, AI Summary) — get a free key at
# https://aistudio.google.com/apikey. Leave blank to run with AI features
# disabled: everything else (upload, versioning, search, etc.) still works.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=3
AI_MAX_EXTRACTED_TEXT_CHARS=20000
