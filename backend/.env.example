# Supabase Postgres — use the Session/Transaction pooler connection string,
# not the direct connection (see docs/DOCBRAIN-ARCHITECTURE.md §9.4).
DATABASE_URL=postgresql+psycopg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

JWT_SECRET=dev-only-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

STORAGE_ROOT=uploads
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=pdf,doc,docx,xls,xlsx,ppt,pptx,txt,md,csv,png,jpg

CORS_ORIGINS=http://localhost:3000

# AI features (Smart Rename, Smart Tags, AI Summary) — get a free key at
# https://aistudio.google.com/apikey. Leave blank to run with AI features
# disabled: everything else (upload, versioning, search, etc.) still works.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=3
AI_MAX_EXTRACTED_TEXT_CHARS=20000
